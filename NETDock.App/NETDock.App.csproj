<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>NETDock</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embedded as icon resource 32512, which App loads for windows and the tray. -->
    <ApplicationIcon>..\assets\NETDock.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- template.json lists every UI string for translators; real translations sit beside it as <Language>.json. -->
    <None Include="languages\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NETDock.Core\NETDock.Core.csproj" />
  </ItemGroup>
</Project>
